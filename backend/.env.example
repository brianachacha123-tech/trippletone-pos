# Cloud-managed Postgres (Neon/Supabase/Render). Use the POOLED connection string.
# TLS is enabled automatically for non-local hosts - node-postgres ignores sslmode=,
# so SSL is set in code (backend/src/config/database.js).
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
PORT=5000
# Set only if your host does NOT use TLS (local dev on localhost detects this automatically).
# PGSSL=disable
# Optional: cap pg pool size (default 10). Keep small on free tiers.
# PGPOOL_MAX=10
# Optional: seed passwords for first-run default users (fallback: admin123 / cashier123)
# Seeded users MUST change their password on first login regardless.
DEFAULT_ADMIN_PASSWORD=change_me_admin
DEFAULT_CASHIER_PASSWORD=change_me_cashier
# Optional: comma-separated cross-origin allowlist (production is same-origin by default)
CORS_ORIGIN=https://your-domain.com
